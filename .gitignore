# some also embed the account's anthicId. The curated review sample is
# force-included below.
*_history.json
proof-of-concepts/all_plays.json

# --- Project config (may hold a session_cookie) ---
config.toml

# --- Tooling / caches ---
.idea/
.claude/
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.uv-cache/
.venv/
*.egg-info/
ignore/
