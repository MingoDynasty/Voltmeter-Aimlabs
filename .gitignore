# --- Secrets / credentials: NEVER commit ---
# Session cookie / bearer tokens are "logged in as you" credentials.
.env
.env.*
!.env.example
*.token
*.cookie

# --- Local data store & cached API responses (personal account data) ---
data/
*.db
*.sqlite
*.sqlite3
